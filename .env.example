# Copy to .env.local for development. In production (Cloudflare) set these as
# Worker variables/secrets; NEXT_PUBLIC_* must also be present at build time.
#
# Only EMAIL is required for the forms to work on the live site. Everything
# else is optional: without a database the email is the record, without R2
# CVs are attached to the email, without Turnstile the honeypot, timing check
# and rate limit still apply. With no email settings, `pnpm dev` uses an
# in-memory outbox (nothing is sent) and a production build fails closed
# (forms return 503 and show the phone number).

NEXT_PUBLIC_SITE_URL=https://senthilsecuritysolutions.com

# Client review preview only: shows pending content with badges, noindex,
# forms run without backends and say "not sent". Never set on the live site.
# NEXT_PUBLIC_REVIEW_MODE=1

# --- Email (required) ---------------------------------------------------
# The company's own mailbox over SMTP: no third-party email service.
# Filled in for the company Gmail. SMTP_PASS must be a Google *App Password*
# (16 letters), not the normal password: Google Account → Security →
# 2-Step Verification (turn on) → App passwords → create one for "Website".
# Other hosts (cPanel, Zoho, Microsoft 365) work too: 465 = TLS,
# 587 = STARTTLS; port 25 is blocked on Cloudflare.
# Check with: pnpm mail:test   (then: pnpm mail:test you@example.com)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# tls | starttls (default: tls on 465, starttls otherwise)
SMTP_SECURE=
SMTP_USER=senthilsolutions.sss@gmail.com
SMTP_PASS=
# Sender; defaults to SMTP_USER. Gmail requires it to match the login.
ENQUIRY_FROM_EMAIL=
# Inbox(es) that receive enquiries; several allowed, comma-separated
ENQUIRY_TO_EMAIL=senthilsolutions.sss@gmail.com
# Inbox for job applications (CVs attached); defaults to ENQUIRY_TO_EMAIL
CAREERS_TO_EMAIL=

# Alternative to SMTP: Resend (used only when SMTP_HOST is empty)
RESEND_API_KEY=

# --- Optional -----------------------------------------------------------
# Neon Postgres (free plan) — pooled connection string. Without it, nothing
# is stored: the notification email is the only record.
DATABASE_URL=

# Cloudflare Turnstile spam check (recommended; free with the Cloudflare account).
# Set both or neither. Dev falls back to Cloudflare's always-pass test keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare R2 (S3 API credentials for the private CV bucket). Without it, CVs
# are attached to the careers email (max 5 MB) and never stored.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Salt for hashing IPs in submission_attempts (long random string). Required
# only with DATABASE_URL.
IP_HASH_SALT=

# Protects POST /api/cron/retention (long random string)
CRON_SECRET=

# Optional: Cloudflare Web Analytics beacon token
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Test only — never set in a real deployment
# E2E_FAKE_BACKENDS=1
