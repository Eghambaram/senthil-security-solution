# Copy to .env.local for development. In production (Cloudflare) set these as
# Worker variables/secrets; NEXT_PUBLIC_* must also be present at build time.
# With no backend values, `pnpm dev` uses in-memory stand-ins (nothing is sent);
# a production build without them fails closed (forms return 503).

NEXT_PUBLIC_SITE_URL=https://senthilsecuritysolutions.com

# Client review preview only: shows pending content with badges, noindex,
# forms run without backends and say "not sent". Never set on the live site.
# NEXT_PUBLIC_REVIEW_MODE=1

# Neon Postgres (free plan) — pooled connection string
DATABASE_URL=

# Resend (free plan: 3,000/month, 100/day) — domain must be verified (SPF/DKIM)
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=noreply@senthilsecuritysolutions.com
CAREERS_TO_EMAIL=

# Cloudflare Turnstile (dev falls back to Cloudflare's always-pass test keys)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare R2 (S3 API credentials for the private CV bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Salt for hashing IPs in submission_attempts (long random string)
IP_HASH_SALT=

# Protects POST /api/cron/retention (long random string)
CRON_SECRET=

# Optional: Cloudflare Web Analytics beacon token
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Test only — never set in a real deployment
# E2E_FAKE_BACKENDS=1
